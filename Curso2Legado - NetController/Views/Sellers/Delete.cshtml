@model Curso2Legado___NetController.Models.Seller
@{
	ViewData["Tittle"] = "Delete";
}
<h2>@ViewData["Tittle"]</h2>

<h3>Voce tem certeza de que quer deletar isso?</h3>
<div>
	<h4>
		<hr />
		<dl class="row">
			<dt class="col-sm-3 text-sm-end fw-bold">
				@Html.DisplayNameFor(m => m.Name)
			</dt>
			<dd class="col-sm-9">
				@Html.DisplayFor(m => m.Name)
			</dd>

			<dt class="col-sm-3 text-sm-end fw-bold">
				@Html.DisplayNameFor(m => m.Email)
			</dt>
			<dd class="col-sm-9">
				@Html.DisplayFor(m => m.Email)
			</dd>

			<dt class="col-sm-3 text-sm-end fw-bold">
				@Html.DisplayNameFor(m => m.BirthDate)
			</dt>
			<dd class="col-sm-9">
				@Html.DisplayFor(m => m.BirthDate)
			</dd>

			<dt class="col-sm-3 text-sm-end fw-bold">
				@Html.DisplayNameFor(m => m.BaseSalary)
			</dt>
			<dd class="col-sm-9">
				@Html.DisplayFor(m => m.BaseSalary)
			</dd>
		</dl>

		<form asp-action="Delete">
			<input type="hidden" asp-for="Id" />
			<input type="submit" value="Delete" class="btn-danger btn" />
		</form>

	</h4>
</div>