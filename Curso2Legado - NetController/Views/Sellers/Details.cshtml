@model Curso2Legado___NetController.Models.Seller
@{
    ViewData["Title"] = "Detalhes";
}

<h1>@ViewData["Tittle"]</h1>

<div>
		<hr />
		<dl class="row">
			<dt class="col-sm-3 text-sm-end fw-bold">
				@Html.DisplayNameFor(m => m.Name)
			</dt>
			<dd class="col-sm-9">
				@Html.DisplayFor(m => m.Name)
			</dd>

			<dt class="col-sm-3 text-sm-end fw-bold">
				@Html.DisplayNameFor(m => m.Email)
			</dt>
			<dd class="col-sm-9">
				@Html.DisplayFor(m => m.Email)
			</dd>

			<dt class="col-sm-3 text-sm-end fw-bold">
				@Html.DisplayNameFor(m => m.BirthDate)
			</dt>
			<dd class="col-sm-9">
				@Html.DisplayFor(m => m.BirthDate)
			</dd>
			<dt class="col-sm-3 text-sm-end fw-bold">
				@Html.DisplayNameFor(m => m.BaseSalary)
			</dt>
			<dd class="col-sm-9">
				@Html.DisplayFor(m => m.BaseSalary)
			</dd>
			<dt class="col-sm-3 text-sm-end fw-bold">
				@Html.DisplayNameFor(m => m.DepartamentId)
			</dt>
			<dd class="col-sm-9">
				@Html.DisplayFor(m => m.Departament.Name)
			</dd>
		</dl>
</div>
<div>
	<a asp-action="Edit" asp-route-id="@Model.Id" class="btn-secondary btn">Editar</a>
	<a asp-action="Index">De volta a listagem!</a>
</div>